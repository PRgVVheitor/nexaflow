{
  "name": "nexaflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "npm run lint --prefix backend",
    "lint:frontend": "npm run lint --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "docker:up": "docker compose up -d --build --wait",
    "docker:up:db": "docker compose up -d --wait db",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v",
    "db:bootstrap": "npm run docker:up && docker compose exec api npm run db:seed",
    "db:generate": "npm run prisma:generate --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:deploy": "npm run db:deploy --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:studio": "npm run db:studio --prefix backend"
  }
}
