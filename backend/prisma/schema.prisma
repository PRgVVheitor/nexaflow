generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(cuid())
  description String
  category    String
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Task {
  id        String   @id @default(cuid())
  title     String
  priority  String   @default("media")
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
